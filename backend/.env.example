# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys. The frontend never sees any of these; every call
# to YouCam / Hyper3D is proxied through this backend.
#
# NOTE: the app takes a public photo URL from the user (see
# frontend UploadStep.jsx), not a file upload — so no tunnel/ngrok or
# PUBLIC_BASE_URL is needed for this backend to be reachable by anything.

PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# --- YouCam API (Perfect Corp) ---
# Get a key at https://yce.perfectcorp.com/api-console/en/api-keys/ — sign
# up, redeem your hackathon code, then create an API key in the dashboard.
# V2 API has no separate token exchange: every request just carries this
# key directly as "Authorization: Bearer YOUCAM_API_KEY". There is no
# secret/RSA-signing step to configure.
YOUCAM_API_KEY=REPLACE_WITH_YOUCAM_API_KEY
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Optional: up to 3 additional YouCam keys/accounts (backend/utils/
# youcamClient.js). When a batch of outfit renders runs, each request is
# rotated across whichever of these are set so they don't all serialize
# against one key's rate limit. Any slot left unset just falls back to
# YOUCAM_API_KEY — you don't need all 4 for the app to work.
YOUCAM_API_KEY_2=REPLACE_WITH_YOUCAM_API_KEY_2
YOUCAM_API_KEY_3=REPLACE_WITH_YOUCAM_API_KEY_3
YOUCAM_API_KEY_4=REPLACE_WITH_YOUCAM_API_KEY_4

# --- Optional: multi-agent LLM styling pipeline (Agent 1 -> 2 -> 3, see
# backend/utils/multiAgentStylist.js) used for the culture/climate-aware
# recommendation copy. If unset, recommendations.js falls back to the
# built-in deterministic rules engine (recommendationEngine.js). Runs on
# Gemini, on its OWN key separate from GEMINI_API_KEY below — this
# pipeline makes 3 chained calls per request, and sharing a key with the
# image-edit agent competed for the same quota. Get a key at
# https://aistudio.google.com/apikey.
GEMINI_API_KEY_2=REPLACE_WITH_GEMINI_API_KEY_2
# Optional: override the model used for the 3-agent pipeline.
GEMINI_MODEL_2=gemini-3.6-flash

# --- Image Edit Prompt Agent (backend/utils/imageEditPromptAgent.js) ---
# Turns the chosen outfit into the { prompt, negative_prompt } pair sent to
# YouCam's image-to-image call. Runs on Gemini rather than Claude. Get a key
# at https://aistudio.google.com/apikey. If unset, vto.js falls back to a
# deterministic prompt built straight from the outfit fields.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
